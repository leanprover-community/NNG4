#. intro h
#. rw [zero_add] at h
#. exact h
#. intro h
#. rw [succ_add] at h
#. apply succ_inj at h
#. apply hd at h
#. exact h
#. ```
#: Game.Levels.AdvAddition.L04add_right_eq_self
#, fuzzy
