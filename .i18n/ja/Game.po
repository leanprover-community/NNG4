#: Game.Levels.Algorithm.L08decide
#. §0: ```
#. instance instDecidableEq : DecidableEq ℕ
#. | 0, 0 => isTrue <| by
#. show 0 = 0
#. rfl
#. | succ m, 0 => isFalse <| by
#. show succ m ≠ 0
#. exact succ_ne_zero m
#. | 0, succ n => isFalse <| by
#. show 0 ≠ succ n
#. exact zero_ne_succ n
#. | succ m, succ n =>
